# Supabase (required for live)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# XPrinter local bridge (runs on cashier PC, not on Vercel)
NEXT_PUBLIC_XPRINTER_BRIDGE_URL=http://127.0.0.1:17809
# Windows USB printer name (Settings > Printers), used by local bridge:
# XPRINTER_MODE=share
# XPRINTER_SHARE=Xprinter

